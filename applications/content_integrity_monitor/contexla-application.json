{
  "manifestVersion": 1,
  "applicationId": "com.contexla.application.content-integrity-monitor",
  "name": "Content Integrity Monitor",
  "icon": "hero-shield-check",
  "version": "0.1.0",
  "otpApplication": "content_integrity_monitor",
  "entryModule": "Contexla.Applications.ContentIntegrityMonitor.Package",
  "sdkRequirement": "~> 0.1",
  "databaseSchema": "contexla_integrity",
  "surfaces": [
    {"id": "new", "path": "new", "module": "Contexla.Applications.ContentIntegrityMonitor.Web.NewLive", "role": "new"},
    {"id": "overview", "path": "overview", "module": "Contexla.Applications.ContentIntegrityMonitor.Web.OverviewLive", "role": "instance", "default": true},
    {"id": "collection", "path": "monitors", "module": "Contexla.Applications.ContentIntegrityMonitor.Web.CollectionLive", "role": "instance"},
    {"id": "settings", "path": "configuration", "module": "Contexla.Applications.ContentIntegrityMonitor.Web.SettingsLive", "role": "instance", "kind": "settings"}
  ],
  "operations": [
    "integrity.demo_setup",
    "integrity.run",
    "integrity.issue.acknowledge",
    "integrity.issue.resolve"
  ]
}
