defmodule <%= module %>.MixProject do
  use Mix.Project

  def project do
    [
      app: :<%= project %>,
      version: "0.1.0",
      elixir: "~> 1.20",
      start_permanent: Mix.env() == :prod,
      deps: deps()
    ]
  end

  def application do
    [extra_applications: [:logger], mod: {<%= module %>.Application, []}]
  end

  defp deps do
    [
      {:contexla_application_sdk, path: "<%= sdk_path %>"},
      {:contexla_ui, path: "<%= ui_path %>"},
      {:jason, "~> 1.2"}
    ]
  end
end
