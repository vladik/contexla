{
  "manifestVersion": 2,
  "applicationId": "<%= id %>",
  "name": "<%= name %>",
  "icon": "hero-squares-2x2",
  "version": "0.1.0",
  "otpApplication": "<%= project %>",
  "entryModule": "<%= package_module %>",
  "sdkRequirement": "~> 0.1",
  "description": "Replace with the independently useful business outcome.",
  "configSchema": {
    "purpose": {"type": "string", "required": true}
  },
  "queues": [
    {"name": "default", "concurrency": 10}
  ],
  "surfaces": [
    {"id": "new", "path": "new", "label": "New Instance", "module": "<%= web_module %>.NewLive", "role": "new"},
    {"id": "overview", "path": "overview", "label": "Overview", "module": "<%= web_module %>.OverviewLive", "role": "instance", "default": true},
    {"id": "collection", "path": "collection", "label": "Records", "module": "<%= web_module %>.CollectionLive", "role": "instance"},
    {"id": "settings", "path": "configuration", "label": "Application settings", "module": "<%= web_module %>.SettingsLive", "role": "instance", "kind": "settings"}
  ],
  "operations": {
    "jobs": [
      {
        "id": "<%= project %>.example",
        "name": "Example job",
        "description": "Describe what this does. Long-running: enqueues a Worker and returns immediately.",
        "queue": "default",
        "maxAttempts": 3,
        "timeoutSeconds": 60,
        "requiresApproval": false,
        "inputSchema": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        }
      }
    ],
    "commands": [],
    "queries": []
  }
}
