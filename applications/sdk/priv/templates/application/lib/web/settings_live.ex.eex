defmodule <%= web_module %>.SettingsLive do
  use Contexla.Ui.ContexlaUi, :live_view

  alias Contexla.Applications.Sdk.{Instance, Runtime}

  @impl true
  def mount(_params, %{"instance" => data}, socket) do
    instance = Instance.from_session!(data)
    {:ok, assign(socket, instance: instance, form: to_form(instance.config, as: :settings))}
  end

  @impl true
  def handle_event("validate", %{"settings" => params}, socket),
    do: {:noreply, assign(socket, :form, to_form(params, as: :settings))}

  def handle_event("save", %{"settings" => params}, socket) do
    instance = socket.assigns.instance

    case Runtime.update_instance_config(instance.actor_id, instance.id, params) do
      {:ok, updated} ->
        updated_instance = %{instance | config: updated.config}
        {:noreply, socket |> assign(instance: updated_instance, form: to_form(updated.config, as: :settings)) |> put_flash(:info, "Settings saved.")}

      {:error, _reason} ->
        {:noreply, put_flash(socket, :error, "Settings could not be saved.")}
    end
  end

  @impl true
  def render(assigns) do
    ~H"""
    <.application_frame id="application-settings" icon="hero-squares-2x2" title={@instance.name} subtitle="Application settings" flash={assigns[:flash]}>
      <:navigation>
        <.tabs id="settings-navigation">
          <:tab label="General" icon="hero-identification" navigate={"/applications/#{@instance.id}/settings"} />
          <:tab label="Application" icon="hero-adjustments-horizontal" navigate={"/applications/#{@instance.id}/configuration"} selected />
        </.tabs>
      </:navigation>
      <.panel title="Application configuration" description="Keep domain-owned settings in this surface.">
        <.form for={@form} id="application-settings-form" phx-change="validate" phx-submit="save">
          <.form_layout>
            <.form_section title="Purpose" description="A one-column sectioned editor is the default form pattern.">
              <.input field={@form[:purpose]} type="textarea" label="Purpose" required rows="4" />
            </.form_section>
            <:actions><.button type="submit" variant="primary">Save changes</.button></:actions>
          </.form_layout>
        </.form>
      </.panel>
    </.application_frame>
    """
  end
end
